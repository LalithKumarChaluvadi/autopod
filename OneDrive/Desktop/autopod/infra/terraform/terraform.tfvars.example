# Copy to terraform.tfvars (gitignored) and fill in real values.
# Never commit terraform.tfvars itself.

aws_region = "us-east-1"

# An EXISTING EC2 key pair name in this account/region (Terraform does not
# create one -- see variables.tf for why).
key_pair_name = "REPLACE_WITH_YOUR_KEY_PAIR_NAME"

# Your team's own IP in /32 form, e.g. "203.0.113.4/32". NEVER "0.0.0.0/0".
admin_cidr = "REPLACE_WITH_YOUR_IP/32"

# Optional: a specific AMI ID for app nodes. If left as "" (or omitted),
# ec2.tf looks up the latest Amazon Linux 2023 AMI automatically.
# app_node_ami_id = ""
