# AutoPod Cloud environment configuration (generated by Ansible)
# Do not edit directly; managed by Ansible role `autopod`.

ADMIN_API_KEY={{ autopod_admin_api_key }}
GITHUB_WEBHOOK_SECRET={{ autopod_webhook_secret }}

DOCKER_USERNAME={{ autopod_docker_username }}
DOCKER_PASSWORD={{ autopod_docker_password }}
DOCKER_REGISTRY=docker.io
DOCKER_GID={{ autopod_docker_gid }}

ALLOWED_ORIGINS={{ autopod_allowed_origins }}

FLASK_DEBUG=false
FLASK_ENV=production
FLASK_RUN_HOST=0.0.0.0
AUTOPOD_DB_PATH={{ autopod_db_path }}

AUTOPOD_DEPLOY_SSH_USER=autopod-deploy
AUTOPOD_DEPLOY_SSH_KEY_PATH={{ autopod_install_dir }}/.ssh/id_rsa

AWS_REGION={{ aws_region | default('us-east-1') }}
AUTOSCALING_GROUP_NAME={{ autoscaling_group_name | default('autopod-app-nodes-asg') }}
AUTOPOD_NODE_IP_ATTRIBUTE=private
