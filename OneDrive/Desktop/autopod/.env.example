# AutoPod Cloud -- Environment Configuration Template
# Copy this file to `.env` and fill in real values before running.
# NEVER commit `.env` or `.dashboard_credentials` (excluded via .gitignore).

# --- Security & Authentication ------------------------------------------------

# Required header value (`X-Admin-Key`) for state-changing API routes.
# Generate a strong 64-character hex token: openssl rand -hex 32
ADMIN_API_KEY=replace-with-64-char-hex-admin-api-key

# Shared secret configured on GitHub repository webhook settings.
# Used to verify the X-Hub-Signature-256 HMAC signature on incoming pushes.
# Generate a strong 64-character hex secret: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=replace-with-64-char-hex-webhook-secret

# Comma-separated list of origins allowed to call the backend API (CORS).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://frontend:80,http://frontend:3000,https://your-dashboard-domain.example.com

# --- Flask & Database ---------------------------------------------------------

# Keep false outside local development; never enable debug in production.
FLASK_DEBUG=false
FLASK_ENV=production
FLASK_RUN_HOST=0.0.0.0

# SQLite database path (inside container volume mount in Docker Compose).
AUTOPOD_DB_PATH=autopod.db

# --- AWS Region, ECR & S3 Storage ---------------------------------------------

# Credentials are sourced via standard IAM role / boto3 credential chain.
# NEVER put AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY inside `.env`.
AWS_REGION=us-east-1
AUTOSCALING_GROUP_NAME=autopod-app-nodes-asg
AUTOPOD_NODE_IP_ATTRIBUTE=private

# Native AWS ECR registry URL (e.g. <account-id>.dkr.ecr.us-east-1.amazonaws.com)
# Leave blank for purely local builds, or configure for ECR push/pull deployments.
DOCKER_REGISTRY=<aws-account-id>.dkr.ecr.us-east-1.amazonaws.com

# S3 bucket used for exporting container Docker image .tar archives via presigned URLs.
AUTOPOD_S3_IMAGES_BUCKET=autopod-images-<aws-account-id>

# --- Optional External Docker Registry (Docker Hub) ---------------------------

# Optional: only required if pushing/pulling external Docker Hub images.
# Production deployments natively authenticate with Amazon ECR using EC2 IAM roles.
DOCKER_USERNAME=
DOCKER_PASSWORD=

# --- Worker Node Deployment & Rollout -----------------------------------------

# Rollout transport method: "ssm" (AWS Systems Manager, recommended) or "ssh"
AUTOPOD_DEPLOY_METHOD=ssm
AUTOPOD_WORKER_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx
AUTOPOD_SSM_TIMEOUT=180
AUTOPOD_ALLOW_LOCAL_FALLBACK=false

# Health check tuning for candidate containers during rolling deploy
HEALTH_CHECK_RETRIES=8
HEALTH_CHECK_DELAY_SECONDS=1.5
NODE_HEALTH_CHECK_RETRIES=8
NODE_HEALTH_CHECK_DELAY_SECONDS=1.5

# SSH fallback credentials (only used when AUTOPOD_DEPLOY_METHOD=ssh)
AUTOPOD_DEPLOY_SSH_USER=autopod-deploy
AUTOPOD_DEPLOY_SSH_KEY_PATH=

# --- Worker Ingress Gateway & Public URLs -------------------------------------

INGRESS_CONF_DIR=/etc/autopod-ingress/conf.d
INGRESS_GATEWAY_PORT=8080

# Public AWS Application Load Balancer base URL serving deployed workloads
AUTOPOD_ALB_URL=http://your-autopod-alb-dns.us-east-1.elb.amazonaws.com/
APP_PUBLIC_URL_SWEET_TREATS_BAKERY=http://your-autopod-alb-dns.us-east-1.elb.amazonaws.com/

# Optional local Docker host IP override for container health probing
# DOCKER_HOST_PROBE_IP=127.0.0.1

# --- Frontend Build / Dev Server Configuration --------------------------------

# In production behind Nginx reverse proxy, leave empty ("") for relative `/api/*` routing.
# For standalone local development, point to http://localhost:5000.
REACT_APP_API_URL=http://localhost:5000
